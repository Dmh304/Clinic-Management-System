
# ============================================================
# Server
# ============================================================
server.port=8080

# ============================================================
# Database (SQL Server)
# ============================================================
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=ecms_db;encrypt=false
spring.datasource.username=sa
spring.datasource.password=0864213579

spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# HikariCP connection pool
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# ============================================================
# JPA / Hibernate
# ============================================================
spring.jpa.database-platform=org.hibernate.dialect.SQLServerDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# ============================================================
# Upload file (ảnh đại diện gói dịch vụ)
# ============================================================
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=10MB

# ============================================================
# JWT
# ============================================================
# Secret must be at least 32 bytes long for HMAC-SHA (HS256/HS384/HS512).
# Use an environment variable like JWT_SECRET for production.
jwt.secret=${JWT_SECRET:ReplaceWithAtLeast32BytesLongSecretKey!!!!}
jwt.access-token-expiration=3600000
jwt.refresh-token-expiration=604800000

# ============================================================
# Google OAuth (đăng nhập bằng tài khoản Google)
# ============================================================
google.oauth.client-id=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ============================================================
# Mail (Gmail SMTP)
# ============================================================
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_APP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# ============================================================
# Frontend base URL (used to build verification/reset links in emails)
# ============================================================
app.frontend-base-url=${FRONTEND_BASE_URL:http://localhost:5173}

# ============================================================
# Payment webhook (UC-22 — thanh toán VietQR tự động) — ThangNBHE201024
# ============================================================
# API key cổng thanh toán phải gửi kèm mỗi webhook: "Authorization: Apikey <key>".
# Sinh chuỗi ngẫu nhiên và khai báo y hệt ở trang cấu hình webhook của SePay.
# Nếu để trống, hệ thống TỪ CHỐI mọi webhook (không cho chạy webhook không bảo vệ).
#
# Muốn thử luồng thanh toán khi chạy local: gọi thẳng /api/v1/payments/webhook bằng curl
# kèm chính key này (xem docs/payment-webhook-demo.md). Hệ thống cố ý KHÔNG có endpoint
# giả lập bỏ qua xác thực — một cửa sau như vậy chỉ cần bật nhầm một lần là ai biết URL
# cũng tự đánh dấu hóa đơn đã thanh toán được.
payment.webhook.api-key=${PAYMENT_WEBHOOK_API_KEY:ecms-local-demo-key-change-me}

# ============================================================
# Swagger / OpenAPI
# ============================================================
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs