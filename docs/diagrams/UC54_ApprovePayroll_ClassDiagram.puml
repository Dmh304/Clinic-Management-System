@startuml UC54_ApprovePayroll_ClassDiagram

' ============================================================================
' UC-54: Approve Payroll  (Actor: Clinic Manager)
' Perspective: Implementation (Spring Boot) — derived from the real backend/ code
'   POST  /api/v1/payroll/generate             -> generateDraft()  (NF 1-2, ALT-1)
'   GET   /api/v1/payroll/periods{,/{id}}      -> listPeriods() / getPeriod()  (NF 3)
'   PATCH /api/v1/payroll/items/{id}           -> updateItem()     (NF 3)
'   POST  /api/v1/payroll/periods/{id}/approve -> approve()        (NF 4-7)
' Every operation here matches 1:1 a message in the UC-54 Sequence Diagram.
' ============================================================================

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam backgroundColor white
skinparam roundcorner 5
skinparam class {
    BackgroundColor #f9f9f9
    ArrowColor #336699
    BorderColor #336699
}

' ─────────────────── Presentation layer ───────────────────
class PayrollController {
    - payrollService: PayrollService
    - userRepository: UserRepository
    + generate(year: Integer, month: Integer): ResponseEntity<ApiResponse<Map<String, Object>>>
    + periods(): ResponseEntity<ApiResponse<List<Map<String, Object>>>>
    + period(id: Long): ResponseEntity<ApiResponse<Map<String, Object>>>
    + updateItem(id: Long, request: PayrollItemUpdateRequest): ResponseEntity<ApiResponse<Map<String, Object>>>
    + approve(userDetails: UserDetails, id: Long): ResponseEntity<ApiResponse<Map<String, Object>>>
}

' ─────────────────── Service layer ───────────────────
interface PayrollService {
    + generateDraft(year: int, month: int): Map<String, Object>
    + listPeriods(): List<Map<String, Object>>
    + getPeriod(periodId: Long): Map<String, Object>
    + updateItem(itemId: Long, request: PayrollItemUpdateRequest): Map<String, Object>
    + approve(periodId: Long, actorUserId: Long): Map<String, Object>
}

class PayrollServiceImpl {
    - doctorRatePerVisit: BigDecimal
    - baseSalaryDoctor: BigDecimal
    - baseSalaryStaff: BigDecimal
    + generateDraft(year: int, month: int): Map<String, Object>
    + listPeriods(): List<Map<String, Object>>
    + getPeriod(periodId: Long): Map<String, Object>
    + updateItem(itemId: Long, request: PayrollItemUpdateRequest): Map<String, Object>
    + approve(periodId: Long, actorUserId: Long): Map<String, Object>
    - isActive(status: String): boolean
    - nz(v: BigDecimal): BigDecimal
    - toPeriodMap(p: PayrollPeriod, withItems: boolean): Map<String, Object>
    - toItemMap(i: PayrollItem): Map<String, Object>
}

interface AuditLogService {
