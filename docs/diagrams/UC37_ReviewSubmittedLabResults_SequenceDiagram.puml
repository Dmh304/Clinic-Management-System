@startuml UC37_ReviewSubmittedLabResults_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-37: Review Submitted Lab Results\n(Simplified Sequence Diagram)

actor       "Doctor"                                            as Doctor
participant "<<WebSocket>>\nWebSocketBroker"                    as WS
participant "<<Service>>\nNotificationService"                  as NS
participant "<<Controller>>\nLabOrderController"           as LC
participant "<<Service>>\nLabOrderService"               as LS
participant "<<ServiceImpl>>\nLabOrderServiceImpl"       as LSImpl
participant "<<Repository>>\nLabOrderRepository"                as LORepo
participant "<<Repository>>\nLabResultRepository"               as LRRepo
participant "<<Repository>>\nMedicalRecordRepository"           as MRRepo
participant "<<Log>>\nAuditLog"                                 as Audit

note over Doctor
  PRE: lab_result exists (status = COMPLETED).
  Doctor is treating physician.
end note

== Step 1 â€” Real-time Notification ==
note over WS
  Triggered when Lab Technician submits results (UC-34).
end note

NS -> WS : push notification to Doctor
activate WS
WS --> Doctor : [WebSocket] "Lab results ready"
deactivate WS

== Step 2 & 3 â€” Doctor Opens Result ==
Doctor -> LC : GET /api/v1/lab-orders/{labOrderId}/results
activate LC

LC -> LC : resolve currentUserId, currentUserRole
LC -> LS : getLabResults(labOrderId, currentUserId, currentUserRole)
activate LS
LS -> LSImpl : getLabResults(labOrderId, currentUserId, currentUserRole)
activate LSImpl

LSImpl -> LORepo : findById(labOrderId)
activate LORepo
LORepo --> LSImpl : LabOrder
deactivate LORepo

LSImpl -> LRRepo : findTopByLabOrderIdOrderByIdDesc(labOrderId)
activate LRRepo
LRRepo --> LSImpl : LabResult
deactivate LRRepo

LSImpl --> LS : LabResultResponse (Full Clinical View)
deactivate LSImpl
LS --> LC : LabResultResponse
deactivate LS

LC --> Doctor : HTTP 200 OK\nApiResponse<LabResultResponse>
deactivate LC

== Step 4, 5, 6 & 7 â€” Doctor Approves Result ==
Doctor -> LC : PUT /api/v1/lab-orders/{labOrderId}/approve
activate LC
LC -> LC : resolve doctorId from JWT

LC -> LS : approveLabResult(labOrderId, doctorId)
activate LS
LS -> LSImpl : approveLabResult(labOrderId, doctorId)
activate LSImpl

LSImpl -> LORepo : findById(labOrderId)
activate LORepo
LORepo --> LSImpl : LabOrder
deactivate LORepo

LSImpl -> LRRepo : findTopByLabOrderIdOrderByIdDesc(labOrderId)
activate LRRepo
LRRepo --> LSImpl : LabResult
deactivate LRRepo

LSImpl -> LRRepo : save(labResult) // status->APPROVED
activate LRRepo
LRRepo --> LSImpl : updatedResult
deactivate LRRepo

LSImpl --> LS : LabOrderResponse
deactivate LSImpl
LS --> LC : LabOrderResponse
deactivate LS

LC -> Audit : logAccess("APPROVE_LAB_RESULT")
activate Audit
Audit --> LC : ok
deactivate Audit

LC --> Doctor : HTTP 200 OK\nApiResponse<LabOrderResponse>
deactivate LC

== ALT - Doctor Requests Retest ==
Doctor -> LC : PUT /api/v1/lab-orders/{labOrderId}/retest\n{ notes }
activate LC
LC -> LC : resolve doctorId from JWT

LC -> LS : requestRetest(labOrderId, doctorId, request)
activate LS
LS -> LSImpl : requestRetest(labOrderId, doctorId, request)
activate LSImpl

LSImpl -> LORepo : save(updatedOrder) // status->PENDING, testTypes...)
activate LORepo
LORepo --> LSImpl : updatedOrder
deactivate LORepo

LSImpl --> LS : LabOrderResponse
deactivate LSImpl
LS --> LC : LabOrderResponse
deactivate LS

LC --> Doctor : HTTP 200 OK\nApiResponse<LabOrderResponse>
deactivate LC

@enduml
