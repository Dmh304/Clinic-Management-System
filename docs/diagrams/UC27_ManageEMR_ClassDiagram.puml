@startuml UC27_ManageEMR_ClassDiagram

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam backgroundColor white
skinparam roundcorner 5
skinparam class {
    BackgroundColor #f9f9f9
    ArrowColor #336699
    BorderColor #336699
}

class EMRController {
    + getByAppointment(appointmentId: Long, userDetails: UserDetails): ResponseEntity<ApiResponse<EMRResponse>>
    + saveEMR(request: EMRRequest): ResponseEntity<ApiResponse<EMRResponse>>
    + getEMRById(id: Long, userDetails: UserDetails): ResponseEntity<ApiResponse<EMRResponse>>
    - resolveDoctorId(userDetails: UserDetails): Long
}

class AppointmentController {
    + abandonExam(appointmentId: Long): ResponseEntity<ApiResponse<AppointmentResponse>>
}

interface EMRService {
    + getOrCreateByAppointmentId(appointmentId: Long, doctorId: Long): EMRResponse
    + saveEMR(request: EMRRequest): EMRResponse
    + getById(id: Long): EMRResponse
}

interface AppointmentService {
    + abandonExam(appointmentId: Long): AppointmentResponse
}

class EMRServiceImpl {
    + getOrCreateByAppointmentId(appointmentId: Long, doctorId: Long): EMRResponse
    + saveEMR(request: EMRRequest): EMRResponse
    + getById(id: Long): EMRResponse
}

class AppointmentServiceImpl {
    + abandonExam(appointmentId: Long): AppointmentResponse
}

class MedicalRecordRepository {
    + findById(id: Long): Optional<MedicalRecord>
    + findByAppointmentId(appointmentId: Long): Optional<MedicalRecord>
    + save(record: MedicalRecord): MedicalRecord
}

class AppointmentRepository {
    + findById(id: Long): Optional<Appointment>
    + save(appointment: Appointment): Appointment
}

class MedicalRecord {
    - recordId: Long
    - appointmentId: Long
    - status: MedicalRecordStatus
    - diagnosis: String
    + getRecordId(): Long
    + setStatus(status: MedicalRecordStatus): void
}

class Appointment {
    - appointmentId: Long
    - status: AppointmentStatus
    + getAppointmentId(): Long
    + setStatus(status: AppointmentStatus): void
}

enum MedicalRecordStatus {
    DRAFT
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum AppointmentStatus {
    PENDING
    CONFIRMED
    WAITING
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

class EMRRequest {
    - appointmentId: Long
    - status: String
    - diagnosis: String
}

class EMRResponse {
    - recordId: Long
    - status: String
    - diagnosis: String
}

class AppointmentResponse {
    - appointmentId: Long
    - status: String
}

class ApiResponse<T> {
    - status: int
    - message: String
    - data: T
}

EMRController ..> EMRService : uses
EMRController ..> ApiResponse : creates
AppointmentController ..> AppointmentService : uses
AppointmentController ..> ApiResponse : creates

EMRService <|.. EMRServiceImpl : implements
AppointmentService <|.. AppointmentServiceImpl : implements

EMRServiceImpl ..> MedicalRecordRepository : uses
EMRServiceImpl ..> AppointmentRepository : uses
EMRServiceImpl ..> EMRRequest : consumes
EMRServiceImpl ..> EMRResponse : creates

AppointmentServiceImpl ..> AppointmentRepository : uses
AppointmentServiceImpl ..> AppointmentResponse : creates

MedicalRecordRepository ..> MedicalRecord : manages
AppointmentRepository ..> Appointment : manages

MedicalRecord "1" -- "1" MedicalRecordStatus : uses >
Appointment "1" -- "1" AppointmentStatus : uses >
MedicalRecord "1" -- "1" Appointment : linked to >

@enduml
