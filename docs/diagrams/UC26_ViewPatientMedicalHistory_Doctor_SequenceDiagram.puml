@startuml UC26_ViewPatientMedicalHistory_Doctor_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-26: View Patient Medical History (Doctor Flow)\n(Simplified Sequence Diagram)

actor       "Doctor"                as Actor
participant "<<Controller>>\nEMRController"         as EMRC
participant "<<Service>>\nEMRService"               as EMRS
participant "<<ServiceImpl>>\nEMRServiceImpl"        as EMRSImpl
participant "<<Repository>>\nMedicalRecordRepository" as Repo
participant "<<Log>>\nAuditLog"                       as Audit

note over Actor
  PRE: Doctor is authenticated.
  Doctor is the treating physician (BR-08).
end note

== Step 1 & 2: Actor Navigates & System Retrieves EMRs ==
Actor -> EMRC : GET /api/v1/emr/patient/{patientId}/history
activate EMRC

EMRC -> EMRC : validateRequestor(JWT, patientId)

alt [E1] Authorisation FAILS (BR-08)
    EMRC -> Audit : logViolation()
    EMRC --> Actor : HTTP 403 Forbidden
else [NORMAL] Authorisation PASSES
    EMRC -> EMRS : getPatientHistory(patientId)
    activate EMRS
    EMRS -> EMRSImpl : getPatientHistory(patientId)
    activate EMRSImpl

    EMRSImpl -> Repo : findByPatientIdOrderByCreatedAtDesc(patientId)
    activate Repo
    Repo --> EMRSImpl : List<MedicalRecord>
    deactivate Repo

    EMRSImpl --> EMRS : ApiResponse<List<EMRResponse>>
    deactivate EMRSImpl
    EMRS --> EMRC : ApiResponse<List<EMRResponse>>
    deactivate EMRS

    EMRC --> Actor : HTTP 200 OK (History List)
    deactivate EMRC
    note right of Actor
      UI renders summary cards for each visit.
    end note
end

== Step 3 & 4: View EMR Details & Log Access ==
Actor -> EMRC : GET /api/v1/emr/appointment/{appointmentId}
activate EMRC

EMRC -> EMRS : getByAppointmentId(appointmentId)
activate EMRS
EMRS -> EMRSImpl : getByAppointmentId(appointmentId)
activate EMRSImpl

EMRSImpl -> Repo : findByAppointmentId(appointmentId)
activate Repo
Repo --> EMRSImpl : MedicalRecord
deactivate Repo

EMRSImpl --> EMRS : EMRResponse (Full Details)
deactivate EMRSImpl
EMRS --> EMRC : EMRResponse
deactivate EMRS

EMRC -> Audit : logAccess("VIEW_EMR_DETAIL")
activate Audit
Audit --> EMRC : ok
deactivate Audit

EMRC --> Actor : HTTP 200 OK (Full EMR Details)
deactivate EMRC

@enduml
