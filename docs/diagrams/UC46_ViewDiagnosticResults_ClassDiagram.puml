@startuml UC46_ViewDiagnosticResults_ClassDiagram

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam backgroundColor white
skinparam roundcorner 5
skinparam class {
    BackgroundColor #f9f9f9
    ArrowColor #336699
    BorderColor #336699
}

class LabOrderController {
    + getLabOrdersForPatient(userDetails: UserDetails): ResponseEntity<ApiResponse<List<LabOrderResponse>>>
    + getLabResults(id: Long, userDetails: UserDetails): ResponseEntity<ApiResponse<LabResultResponse>>
}

interface LabOrderService {
    + getLabOrdersForPatient(patientId: Long): List<LabOrderResponse>
    + getLabResults(id: Long, currentUserId: Long, role: String): LabResultResponse
}

class LabOrderServiceImpl {
    + getLabOrdersForPatient(patientId: Long): List<LabOrderResponse>
    + getLabResults(id: Long, currentUserId: Long, role: String): LabResultResponse
}

class LabOrderRepository {
    + findByMedicalRecord_PatientIdOrderByCreatedAtDesc(patientId: Long): List<LabOrder>
}

class LabResultRepository {
    + findByLabOrderId(labOrderId: Long): LabResult
}

class LabOrder {
    - id: Long
    - status: LabOrderStatus
    - serviceName: String
    - createdAt: LocalDateTime
}

class LabResult {
    - id: Long
    - vaL: BigDecimal
    - vaR: BigDecimal
    - bcvaL: BigDecimal
    - bcvaR: BigDecimal
    - sphL: BigDecimal
    - cylL: BigDecimal
    - axisL: Integer
    - iopL: BigDecimal
    - sphR: BigDecimal
    - cylR: BigDecimal
    - axisR: Integer
    - iopR: BigDecimal
    - imageUrls: String
    - doctorNotes: String
}

enum LabOrderStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    APPROVED
    RETEST
}

class LabOrderResponse {
    - id: Long
    - serviceName: String
    - status: String
    - createdAt: LocalDateTime
}

class LabResultResponse {
    - id: Long
    - vaL: BigDecimal
    - vaR: BigDecimal
    - bcvaL: BigDecimal
    - bcvaR: BigDecimal
    - sphL: BigDecimal
    - cylL: BigDecimal
    - axisL: Integer
    - iopL: BigDecimal
    - sphR: BigDecimal
    - cylR: BigDecimal
    - axisR: Integer
    - iopR: BigDecimal
    - imageUrls: String
    - doctorNotes: String
}

class ApiResponse<T> {
    - status: int
    - message: String
    - data: T
}

LabOrderController ..> LabOrderService : uses
LabOrderController ..> ApiResponse : creates
LabOrderService <|.. LabOrderServiceImpl : implements

LabOrderServiceImpl ..> LabOrderRepository : uses
LabOrderServiceImpl ..> LabResultRepository : uses

LabOrderServiceImpl ..> LabOrderResponse : creates
LabOrderServiceImpl ..> LabResultResponse : creates

LabOrderRepository ..> LabOrder : manages
LabResultRepository ..> LabResult : manages

LabOrder "1" -- "1" LabOrderStatus : uses >
LabOrder "1" -- "0..1" LabResult : contains >

@enduml
