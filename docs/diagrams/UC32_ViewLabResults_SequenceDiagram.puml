@startuml UC32_ViewLabResults_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-32: View Lab Results\n(Simplified Sequence Diagram)

actor       "Doctor / Patient"                                  as Actor
participant ":LabOrderController"           as LC
participant ":LabOrderService"               as LS
participant ":LabOrderServiceImpl"       as LSImpl
participant ":LabOrderRepository"                as LORepo
participant ":LabResultRepository"               as LRRepo
participant "<<Log>>\nAuditLog"                                 as Audit

note over Actor
  PRE: Access control enforced per BR-08.
end note

== Step 1 & 2: Actor Navigates & System Retrieves Lab Results ==
Actor -> LC : GET /api/v1/lab-orders/{medicalRecordId}/results
activate LC

LC -> LC : resolve currentUserId, currentUserRole

alt [E1] BR-08 access control FAILS
    LC -> Audit : logViolation()
    LC --> Actor : HTTP 403 Forbidden
else [NORMAL] Access control PASSES
    LC -> LS : getLabOrdersForMedicalRecord(medicalRecordId)
    activate LS
    LS -> LSImpl : getLabOrdersForMedicalRecord(medicalRecordId)
    activate LSImpl

    LSImpl -> LORepo : findByMedicalRecordId(medicalRecordId)
    activate LORepo
    LORepo --> LSImpl : List<LabOrder> labOrders
    deactivate LORepo

    alt [E1-NoPending] labOrders is EMPTY
        LSImpl --> LS : []
        LS --> LC : []
        LC --> Actor : HTTP 200 OK\nApiResponse<[]>
        note right of Actor
          UI shows: "Results are pending..."
        end note
    else [NORMAL] labOrders NOT EMPTY
        loop for each LabOrder
            LSImpl -> LRRepo : findByLabOrderId(order.id)
            activate LRRepo
            LRRepo --> LSImpl : Optional<LabResult> result
            deactivate LRRepo

            note right of LSImpl
              Builds LabOrderResponse with results.
            end note
        end

        LSImpl --> LS : List<LabOrderResponse>
        deactivate LSImpl
        LS --> LC : List<LabOrderResponse>
        deactivate LS

        LC --> Actor : HTTP 200 OK\nApiResponse<List<LabOrderResponse>>
        
        LC -> Audit : logAccess("VIEW_LAB_RESULT")
        activate Audit
        Audit --> LC : ok
        deactivate Audit
        
    end
end
deactivate LC

== Step 4 (Patient Only): Download as PDF ==
opt Actor clicks "Download as PDF"
    Actor -> LC : GET /api/v1/lab-orders/{labOrderId}/pdf
    activate LC
    LC -> LS : getLabResults(labOrderId, currentUserId, currentUserRole)
    activate LS
    LS -> LSImpl : getLabResults(labOrderId, currentUserId, currentUserRole)
    activate LSImpl
    
    LSImpl -> LORepo : fetch LabOrder
    LSImpl -> LRRepo : fetch LabResult
    LSImpl -> LSImpl : generate PDF bytes
    
    LSImpl --> LS : byte[] pdfBytes
    deactivate LSImpl
    LS --> LC : byte[] pdfBytes
    deactivate LS
    
    LC --> Actor : HTTP 200 OK (application/pdf)
    deactivate LC
end

@enduml
