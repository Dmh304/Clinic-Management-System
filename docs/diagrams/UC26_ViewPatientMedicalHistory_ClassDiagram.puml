@startuml UC26_ViewPatientMedicalHistory_ClassDiagram

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam backgroundColor white
skinparam roundcorner 5
skinparam class {
    BackgroundColor #f9f9f9
    ArrowColor #336699
    BorderColor #336699
}

class EMRController {
    + getPatientHistory(patientId: Long): ResponseEntity<ApiResponse<List<EMRResponse>>>
    + getByAppointment(appointmentId: Long): ResponseEntity<ApiResponse<EMRResponse>>
}

class AppointmentController {
    + getMyAppointments(userDetails: UserDetails): ResponseEntity<ApiResponse<List<AppointmentResponse>>>
}

interface EMRService {
    + getPatientHistory(patientId: Long): List<EMRResponse>
    + getOrCreateByAppointmentId(appointmentId: Long, doctorId: Long): EMRResponse
}

interface AppointmentService {
    + getMyAppointments(userId: Long): List<AppointmentResponse>
}

class EMRServiceImpl {
    + getPatientHistory(patientId: Long): List<EMRResponse>
    + getOrCreateByAppointmentId(appointmentId: Long, doctorId: Long): EMRResponse
}

class AppointmentServiceImpl {
    + getMyAppointments(userId: Long): List<AppointmentResponse>
}

class MedicalRecordRepository {
    + findByPatientIdOrderByCreatedAtDesc(patientId: Long): List<MedicalRecord>
    + findByAppointmentId(appointmentId: Long): MedicalRecord
}

class AppointmentRepository {
    + findByUserId(userId: Long): List<Appointment>
}

class AuditLog {
    + logAction(action: String, details: String): void
}

class MedicalRecord {
    - recordId: Long
    - status: MedicalRecordStatus
    - diagnosis: String
    - createdAt: LocalDateTime
}

class Appointment {
    - appointmentId: Long
    - scheduledTime: LocalDateTime
}

enum MedicalRecordStatus {
    DRAFT
    COMPLETED
    CANCELLED
}

class Patient {
    - patientId: Long
    - fullName: String
}

class EMRResponse {
    - recordId: Long
    - date: LocalDate
    - diagnosis: String
    - status: String
}

class AppointmentResponse {
    - appointmentId: Long
    - scheduledTime: LocalDateTime
    - status: String
}

class ApiResponse<T> {
    - status: int
    - message: String
    - data: T
}

EMRController ..> EMRService : uses
EMRController ..> ApiResponse : creates
AppointmentController ..> AppointmentService : uses
AppointmentController ..> ApiResponse : creates

EMRService <|.. EMRServiceImpl : implements
AppointmentService <|.. AppointmentServiceImpl : implements

EMRServiceImpl ..> MedicalRecordRepository : uses
EMRServiceImpl ..> AuditLog : uses
EMRServiceImpl ..> EMRResponse : creates

AppointmentServiceImpl ..> AppointmentRepository : uses
AppointmentServiceImpl ..> AppointmentResponse : creates

MedicalRecordRepository ..> MedicalRecord : manages
AppointmentRepository ..> Appointment : manages

MedicalRecord "1" -- "1" MedicalRecordStatus : uses >
MedicalRecord "0..*" -- "1" Patient : belongs to >
Appointment "0..*" -- "1" Patient : belongs to >

@enduml
