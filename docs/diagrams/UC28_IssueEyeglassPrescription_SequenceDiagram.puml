@startuml UC28_IssueEyeglassPrescription
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-28: Issue Eyeglass Prescription\n(Simplified Sequence Diagram)

actor       "Doctor"                                            as Doctor
participant "<<Controller>>\nEyeglassPrescriptionController"    as EPC
participant "<<Service>>\nEyeglassPrescriptionService"          as EPS
participant "<<ServiceImpl>>\nEyeglassPrescriptionServiceImpl"  as EPSImpl
participant "<<Repository>>\nMedicalRecordRepository"           as MRRepo
participant "<<Repository>>\nEyeglassPrescriptionRepository"    as EPRepo

note over Doctor
  PRE: Doctor is authenticated.
  MedicalRecord exists.
end note

== Step 1 & 2: Doctor Issues Prescription ==
Doctor -> EPC : POST /api/v1/prescriptions/eyeglasses\n{medicalRecordId, rightEye..., notes}
activate EPC
EPC -> EPC : get doctorEmail from JWT
EPC -> EPS : createPrescription(request, doctorEmail)
activate EPS
EPS -> EPSImpl : createPrescription(request, doctorEmail)
activate EPSImpl

EPSImpl -> MRRepo : findById(request.medicalRecordId)
activate MRRepo
MRRepo --> EPSImpl : MedicalRecord
deactivate MRRepo

EPSImpl -> EPRepo : findByMedicalRecordId(request.medicalRecordId)
activate EPRepo
EPRepo --> EPSImpl : empty (Validates no existing record)
deactivate EPRepo

EPSImpl -> EPRepo : create EyeglassPrescription
activate EPRepo
EPRepo --> EPSImpl : savedPrescription
deactivate EPRepo

EPSImpl --> EPS : EyeglassPrescriptionResponse
deactivate EPSImpl
EPS --> EPC : EyeglassPrescriptionResponse
deactivate EPS

EPC --> Doctor : HTTP 201 Created\nApiResponse<EyeglassPrescriptionResponse>
deactivate EPC

@enduml
