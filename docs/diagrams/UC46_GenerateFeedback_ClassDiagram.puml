FeedbackServiceImpl ..> CareSessionRepository : <<use>>
FeedbackServiceImpl ..> MedicalRecordRepository : <<use>>
FeedbackServiceImpl ..> LabOrderRepository : <<use>>
FeedbackServiceImpl ..> UserRepository : <<use>>
FeedbackServiceImpl ..> NotificationService : <<use>>
