@startuml UC46_GenerateFeedback_ClassDiagram

' ============================================================================
' UC-46: Generate Feedback  (Actor: Patient)   [SRS reference: UC-48 Generate Feedback]
' Perspective: Implementation (Spring Boot) — derived from the real backend/ code
'   POST /api/v1/feedbacks                                    -> submitFeedback()
'   GET  /api/v1/feedbacks/appointment/{id}/participants      -> getVisitParticipants()
'   GET  /api/v1/feedbacks/my                                 -> getMyFeedbacks()
' The stored records feed the Clinic Manager's report (UC-53 Generate Feedback Report).
' Every operation here matches 1:1 a message in the UC-46 Sequence Diagram.
' ============================================================================

' ── Layout tuning: keeps the graph compact instead of sprawling sideways ─────
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 45
skinparam wrapWidth 260
skinparam padding 2

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam backgroundColor white
skinparam roundcorner 5
skinparam class {
    BackgroundColor #f9f9f9
    ArrowColor #336699
    BorderColor #336699
}
skinparam package {
    BackgroundColor #FCFCFC
    BorderColor #BBBBBB
    FontColor #555555
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor #AAAAAA
}

package "Presentation" {
    class FeedbackController {
        - feedbackService: FeedbackService
        - userRepository: UserRepository
        - patientRepository: PatientRepository
        + submit(userDetails: UserDetails, request: FeedbackRequest): ResponseEntity<ApiResponse<FeedbackResponse>>
        + participants(userDetails: UserDetails, appointmentId: Long): ResponseEntity<ApiResponse<Map<String, Object>>>
        + myFeedbacks(userDetails: UserDetails): ResponseEntity<ApiResponse<List<FeedbackResponse>>>
        - resolvePatientId(userDetails: UserDetails): Long
    }
}

package "Service" {
    interface FeedbackService {
        + submitFeedback(patientId: Long, request: FeedbackRequest): FeedbackResponse
        + getMyFeedbacks(patientId: Long): List<FeedbackResponse>
        + getVisitParticipants(patientId: Long, appointmentId: Long): Map<String, Object>
    }

    class FeedbackServiceImpl {
        + submitFeedback(patientId: Long, request: FeedbackRequest): FeedbackResponse
        + getMyFeedbacks(patientId: Long): List<FeedbackResponse>
        + getVisitParticipants(patientId: Long, appointmentId: Long): Map<String, Object>
        - submitAppointmentFeedback(patientId: Long, request: FeedbackRequest): Feedback
        - submitCareSessionFeedback(patientId: Long, request: FeedbackRequest): Feedback
        - attachParticipantRatings(feedback: Feedback, request: FeedbackRequest): void
        - person(role: String, label: String, name: String, extra: String): Map<String, Object>
        - toResponse(f: Feedback): FeedbackResponse
    }

    interface NotificationService {
        + createForManagers(message: String, relatedEntityId: Long, relatedEntityType: String): void
    }
}

package "Repository" {
    interface FeedbackRepository {
        + save(feedback: Feedback): Feedback
        + existsByAppointment_Id(appointmentId: Long): boolean
        + existsByCareSession_Id(careSessionId: Long): boolean
        + findByPatient_IdOrderByCreatedAtDesc(patientId: Long): List<Feedback>
    }
    interface AppointmentRepository {
        + findById(id: Long): Optional<Appointment>
    }
    interface CareSessionRepository {
        + findById(id: Long): Optional<CareSession>
    }
    interface MedicalRecordRepository {
        + findByAppointmentId(appointmentId: Long): Optional<MedicalRecord>
    }
    interface LabOrderRepository {
        + findByMedicalRecordIdOrderByCreatedAt(medicalRecordId: Long): List<LabOrder>
    }
    interface UserRepository {
        + findByEmail(email: String): Optional<User>
        + findById(id: Long): Optional<User>
    }
    interface PatientRepository {
        + findByUserId(userId: Long): Optional<Patient>
    }
}

package "DTO" {
    class FeedbackRequest <<DTO>> {
        - appointmentId: Long
        - careSessionId: Long
        - rating: Integer
        - content: String
        - isAnonymous: Boolean
        - participantRatings: List<ParticipantRating>
    }
    class ParticipantRating <<DTO>> {
        - role: String
        - name: String
        - rating: Integer
    }
    class FeedbackResponse <<DTO>> {
        - id: Long
        - appointmentId: Long
        - careSessionId: Long
        - patientId: Long
        - patientName: String
        - doctorId: Long
        - doctorName: String
        - nurseId: Long
        - nurseName: String
        - rating: Integer
        - content: String
        - isAnonymous: Boolean
        - status: String
        - createdAt: LocalDateTime
    }
    class ApiResponse<T> <<DTO>> {
        - success: boolean
        - message: String
        - data: T
        + {static} success(data: T): ApiResponse<T>
    }
}

package "Domain" {
    class Feedback <<Entity>> {
        - id: Long
        - rating: Integer
        - content: String
        - isAnonymous: Boolean
        - status: String
        - createdAt: LocalDateTime
    }
    class FeedbackParticipantRating <<Entity>> {
        - id: Long
        - participantRole: String
        - participantName: String
        - rating: Integer
    }
    class Patient <<Entity>> {
        - id: Long
        - fullName: String
        + getId(): Long
    }
    class Appointment <<Entity>> {
        - id: Long
        - appointmentTime: LocalDateTime
        - timeSlot: String
        - status: AppointmentStatus
        - checkInBy: Long
    }
    class CareSession <<Entity>> {
        - id: Long
        - sessionNumber: Integer
        - scheduledDateTime: LocalDateTime
        - status: String
    }
    class Doctor <<Entity>> {
        - id: Long
        - fullName: String
        - specialization: String
    }
    class User <<Entity>> {
        - id: Long
        - email: String
        - fullName: String
        - role: Role
    }
    class ResourceNotFoundException <<Exception>> {
        + ResourceNotFoundException(message: String)
    }
}

