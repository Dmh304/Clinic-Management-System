@startuml UC28_ViewPatientMedicalHistory_Patient_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-28: View Patient Medical History (Patient Flow)\n(Simplified Sequence Diagram)

actor       "Patient"                               as Actor
participant ":AppointmentController" as AC
participant ":AppointmentService"       as AS
participant ":AppointmentServiceImpl" as ASImpl
participant ":AppointmentRepository" as ARepo
participant ":EMRController"         as EMRC
participant ":EMRService"               as EMRS
participant ":EMRServiceImpl"        as EMRSImpl
participant ":MedicalRecordRepository" as MRRepo

note over Actor
  PRE: Patient is authenticated.
end note

== Step 1: Patient Views Appointment History ==
Actor -> AC : getMyAppointments(userDetails: UserDetails)
activate AC

AC -> AS : getMyAppointments(userId: Long)
activate AS
AS -> ASImpl : getMyAppointments(userId: Long)
activate ASImpl

ASImpl -> ARepo : findByUserId(userId: Long)
activate ARepo
ARepo --> ASImpl : List<Appointment>
deactivate ARepo

ASImpl --> AS : List<AppointmentResponse>
deactivate ASImpl
AS --> AC : List<AppointmentResponse>
deactivate AS

AC --> Actor : ResponseEntity<ApiResponse<List<AppointmentResponse>>>
deactivate AC

note right of Actor
  UI displays the patient's appointment history.
end note

== Step 2: Patient Selects an Appointment to View EMR ==
Actor -> EMRC : getByAppointment(appointmentId: Long)
activate EMRC

EMRC -> EMRS : getOrCreateByAppointmentId(appointmentId: Long, doctorId: null)
activate EMRS
EMRS -> EMRSImpl : getOrCreateByAppointmentId(appointmentId: Long, doctorId: null)
activate EMRSImpl

EMRSImpl -> MRRepo : findByAppointmentId(appointmentId: Long)
activate MRRepo
MRRepo --> EMRSImpl : MedicalRecord
deactivate MRRepo

EMRSImpl --> EMRS : EMRResponse
deactivate EMRSImpl
EMRS --> EMRC : EMRResponse
deactivate EMRS

EMRC --> Actor : ResponseEntity<ApiResponse<EMRResponse>>
deactivate EMRC

@enduml
