@startuml UC27a_InitiateEMR_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-27a: Initiate Electronic Medical Record (EMR)\n(Simplified Sequence Diagram)

actor       "Doctor"                                    as Doctor
participant ":EMRController"             as EMRC
participant ":EMRService"                   as EMRS
participant ":EMRServiceImpl"           as EMRSImpl
participant ":MedicalRecordRepository"   as MRRepo
participant ":AppointmentRepository"     as ARepo

note over Doctor
  PRE-1: Doctor is logged in.
  PRE-2: Patient is present in today's queue with "Waiting" status.
end note

== Step 1 & 2: Doctor Views Queue & Selects Patient ==
Doctor -> EMRC : [UI] Selects "Waiting" patient to start assessment

== Step 3, 4 & 5: Start Examination (Status -> IN_PROGRESS) ==
Doctor -> EMRC : getByAppointment(appointmentId, userDetails)
activate EMRC
EMRC -> EMRC : resolveDoctorId(userDetails)
EMRC -> EMRS : getOrCreateByAppointmentId(appointmentId, doctorId)
activate EMRS
EMRS -> EMRSImpl : getOrCreateByAppointmentId(appointmentId, doctorId)
activate EMRSImpl

EMRSImpl -> ARepo : findById(id: Long)
activate ARepo
ARepo --> EMRSImpl : Appointment (status = WAITING)
deactivate ARepo

EMRSImpl -> MRRepo : findByAppointmentId(appointmentId: Long)
activate MRRepo
MRRepo --> EMRSImpl : null (First time)
deactivate MRRepo

EMRSImpl -> MRRepo : save(record: MedicalRecord)
activate MRRepo
note right of MRRepo
  POST-2: A new active EMR form
  is initialized for the session.
  status = IN_PROGRESS
end note
MRRepo --> EMRSImpl : MedicalRecord
deactivate MRRepo

EMRSImpl -> ARepo : save(appointment: Appointment)
activate ARepo
note right of ARepo
  POST-1: Patient queue status is 
  updated to "In Progress".
  status = IN_PROGRESS
end note
ARepo --> EMRSImpl : Appointment
deactivate ARepo

EMRSImpl --> EMRS : EMRResponse
deactivate EMRSImpl
EMRS --> EMRC : EMRResponse
deactivate EMRS

EMRC --> Doctor : HTTP 200 OK
ApiResponse<EMRResponse>
deactivate EMRC

@enduml
