@startuml UC27b_UpdateEMR_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-27b: Update EMR Draft\n(Simplified Sequence Diagram)

actor       "Doctor"                                    as Doctor
participant "<<Controller>>\nEMRController"             as EMRC
participant "<<Service>>\nEMRService"                   as EMRS
participant "<<ServiceImpl>>\nEMRServiceImpl"           as EMRSImpl
participant "<<Repository>>\nMedicalRecordRepository"   as MRRepo

note over Doctor
  PRE: MedicalRecord exists and is in DRAFT or IN_PROGRESS status.
  Doctor is entering data into the UI.
end note

== Step 1: Doctor Enters Data ==
note over Doctor
  Doctor fills out clinical data points.
  System triggers auto-save or Doctor clicks "Save Draft".
end note

== Step 2 & 3: Save Draft (Manual or Auto-Save) ==
Doctor -> EMRC : saveEMR(request: EMRRequest)
activate EMRC
EMRC -> EMRS : saveEMR(request: EMRRequest)
activate EMRS
EMRS -> EMRSImpl : saveEMR(request: EMRRequest)
activate EMRSImpl

EMRSImpl -> MRRepo : findById(id: Long)
activate MRRepo
MRRepo --> EMRSImpl : MedicalRecord
deactivate MRRepo

note right of EMRSImpl
  BR-09: Updates record details 
  while retaining DRAFT status.
end note

EMRSImpl -> MRRepo : save(record: MedicalRecord)
activate MRRepo
MRRepo --> EMRSImpl : MedicalRecord
deactivate MRRepo

EMRSImpl --> EMRS : EMRResponse
deactivate EMRSImpl
EMRS --> EMRC : EMRResponse
deactivate EMRS

EMRC --> Doctor : ResponseEntity<ApiResponse<EMRResponse>>
deactivate EMRC

== Step 4: Resume Draft ==
note over Doctor
  If Doctor closes the tab and returns later.
end note

Doctor -> EMRC : getById(medicalRecordId: Long)
activate EMRC
EMRC -> EMRS : getById(medicalRecordId: Long)
activate EMRS
EMRS -> EMRSImpl : getById(medicalRecordId: Long)
activate EMRSImpl

EMRSImpl -> MRRepo : findById(id: Long)
activate MRRepo
MRRepo --> EMRSImpl : MedicalRecord
deactivate MRRepo

EMRSImpl --> EMRS : EMRResponse
deactivate EMRSImpl
EMRS --> EMRC : EMRResponse
deactivate EMRS

EMRC --> Doctor : ResponseEntity<ApiResponse<EMRResponse>>
deactivate EMRC

@enduml
