@startuml UC34_RecordAndSubmitLabResults
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-34: Record and Submit Lab Results\n(Simplified Sequence Diagram)

actor       "LabTech/Doctor"                                    as Actor
participant "<<Controller>>\nLabOrderController"           as LC
participant "<<Service>>\nLabOrderService"               as LS
participant "<<ServiceImpl>>\nLabOrderServiceImpl"       as LSImpl
participant "<<Service>>\nStorageService"                       as Storage
participant "<<Repository>>\nLabOrderRepository"                as LORepo
participant "<<Repository>>\nLabResultRepository"               as LRRepo
participant "<<Service>>\nNotificationService"                  as NS
participant "<<WebSocket>>\nWebSocketBroker"                    as WS

note over Actor
  PRE: LabOrder with status = PENDING exists.
end note

Actor -> Actor : [UI] Enters results (Refraction, IOP, Image)
Actor -> LC : POST /api/v1/lab-orders/{orderId}/results\n{measuredValues, attachedImages}
activate LC
LC -> LC : resolve labTechnicianId from JWT
LC -> LS : submitLabResult(orderId, request, labTechnicianId)
activate LS
LS -> LSImpl : submitLabResult(orderId, request, labTechnicianId)
activate LSImpl

LSImpl -> LORepo : findById(request.labOrderId)
activate LORepo
LORepo --> LSImpl : LabOrder (PENDING)
deactivate LORepo

opt if request has image file
    LSImpl -> Storage : uploadFile(image)
    activate Storage
    alt E1: Image upload failure
        Storage --> LSImpl : throw StorageException
        LSImpl --> LS : throw Exception
        LS --> LC : throw Exception
        LC --> Actor : HTTP 500 (Upload failed)
    else success
        Storage --> LSImpl : imageUrl
    end
    deactivate Storage
end

LSImpl -> LRRepo : create LabResult (status=COMPLETED)
activate LRRepo
LRRepo --> LSImpl : savedResult
deactivate LRRepo

LSImpl -> LORepo : update LabOrder (status=COMPLETED)
activate LORepo
LORepo --> LSImpl : savedOrder
deactivate LORepo

== Real-time Sync & Notification (< 5 seconds) ==
LSImpl ->> NS : notifyDoctorOfLabResult(savedOrder, savedResult)
NS -> WS : push notification to Doctor's active session
activate WS
WS --> Actor : (Pushed to UI)
deactivate WS

LSImpl --> LS : LabOrderResponse
deactivate LSImpl
LS --> LC : LabOrderResponse
deactivate LS

LC --> Actor : HTTP 200 OK\nApiResponse<LabOrderResponse>
deactivate LC

@enduml
