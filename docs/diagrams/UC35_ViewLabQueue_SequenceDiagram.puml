@startuml UC35_ViewLabQueue_SequenceDiagram
<style>
document {
  ParticipantPadding 10
  BoxPadding 10
}
</style>

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

skinparam participant {
    BackgroundColor #DDEEFF
    BorderColor     #336699
    FontStyle       bold
}
skinparam actor {
    BackgroundColor #FFFACD
    BorderColor     #CC9900
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor     #AAAAAA
}
skinparam ArrowColor #336699
skinparam LifeLineBorderColor #336699

title UC-35: View Lab Queue\n(Simplified Sequence Diagram)

actor       "LabTechnician"                                    as LabTech
participant ":LabOrderController"           as LC
participant ":LabOrderService"               as LS
participant ":LabOrderServiceImpl"       as LSImpl
participant ":LabOrderRepository"               as LRepo
participant "<<Scheduler>>\nPollingTimer"                      as Poll

note over LabTech
  PRE: Lab Technician is authenticated.
end note

== Step 1, 2 & 3: Retrieve and Display Lab Queue ==
LabTech -> LC : getLabOrderQueue(userDetails)
activate LC
LC -> LC : resolveLabTechnicianId(userDetails)
LC -> LS : getLabQueue(labTechnicianId)
activate LS
LS -> LSImpl : getLabQueue(labTechnicianId)
activate LSImpl

LSImpl -> LRepo : findByStatusOrderByCreatedAtAsc(PENDING)
activate LRepo
LRepo --> LSImpl : List<LabOrder>
deactivate LRepo

note right of LSImpl
  Maps LabOrder to LabOrderResponse.
end note

LSImpl --> LS : List<LabOrderResponse>
deactivate LSImpl
LS --> LC : List<LabOrderResponse>
deactivate LS

LC --> LabTech : HTTP 200 OK\nApiResponse<List<LabOrderResponse>>
deactivate LC
note right of LabTech
  UI displays PENDING lab orders.
  Sorted by order time (oldest first).
end note

== Real-time Queue Refresh ==
LabTech -> Poll : [UI] startPolling(30s)
activate Poll
loop every 30s
    Poll -> LC : getLabOrderQueue(userDetails)
    activate LC
    LC -> LS : getLabQueue(labTechnicianId)
    activate LS
    LS -> LSImpl : getLabQueue(labTechnicianId)
    activate LSImpl
    LSImpl -> LRepo : fetch current PENDING orders
    activate LRepo
    LRepo --> LSImpl : List<LabOrder>
    deactivate LRepo
    LSImpl --> LS : List<LabOrderResponse>
    deactivate LSImpl
    LS --> LC : List<LabOrderResponse>
    deactivate LS
    LC --> Poll : HTTP 200 OK
    deactivate LC
    Poll -> LabTech : [UI] refresh queue table
end

== Step 4: Select an Order (Delegates to UC-36) ==
LabTech -> Poll : [UI] stopPolling()
deactivate Poll

note over LabTech
  UI loads Test Execution form based on selected lab order data.
  Handover to UC-36: Process Lab Result.
end note

@enduml
